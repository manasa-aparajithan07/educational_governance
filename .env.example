# Application Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL with SQLite local dev fallback)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=education_governance_db
DB_USER=postgres
DB_PASSWORD=postgres_secure_password_2026
# Optional direct database connection string
DATABASE_URL=postgres://postgres:postgres_secure_password_2026@localhost:5432/education_governance_db

# Security & JWT Tokens
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_change_in_production
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=10485760

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging Configuration
LOG_LEVEL=info

# Hyperledger Fabric Blockchain Configuration
FABRIC_ENABLED=false
FABRIC_CHANNEL_NAME=educhannel
FABRIC_CHAINCODE_NAME=education
FABRIC_MSP_ID=Org1MSP
FABRIC_IDENTITY_NAME=admin
FABRIC_CONNECTION_PROFILE_PATH=chaincode/education/connection-org1.json
FABRIC_CERT_PATH=chaincode/education/msp/signcerts/cert.pem
FABRIC_PRIVATE_KEY_PATH=chaincode/education/msp/keystore/key.pem
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_GATEWAY_DISCOVERY_ENABLED=true
